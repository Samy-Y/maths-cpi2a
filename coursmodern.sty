% 11. EN-TÊTE UNIFORME DES ENVIRONNEMENTS
% ----------------------------------------------------------------------
\newcommand{\drawenvbadge}[5]{%
  \begin{tikzpicture}[baseline={(0,0.2)}]
    \fill[#1, rounded corners=0.8pt] (0,0) rectangle (0.14, 0.65);
    \fill[#1, rounded corners=0.8pt] (0.24,0) rectangle (0.38, 0.65);
    \fill[#1, rounded corners=0.8pt] (0.55, 0) -- (6.05, 0) -- (5.70, 0.65) -- (0.55, 0.65) -- cycle;
    \node[anchor=west, text=white, font=\sffamily\bfseries\small, inner sep=0pt] at (0.75, 0.325) {%
      \ifstrempty{#2}{#3}{#2\hspace{2.2mm}#3}%
    };
    \if\relax\detokenize{#4}\relax\else
      \node[anchor=east, text=white, font=\sffamily\scriptsize, inner sep=0pt] at (5.52, 0.325) {#4};
    \fi
    \if\relax\detokenize{#5}\relax\else
      \node[anchor=west, text=swissdark, font=\sffamily\bfseries\normalsize, inner sep=0pt] at (6.28, 0.325) {#5};
    \fi
  \end{tikzpicture}%
}

\newcommand{\exercisestars}[1]{%
  \ifcase#1\relax
  \or{\color{white}\faIcon{star}}%
  \or{\color{white}\faIcon{star}}\hspace{1pt}{\color{white}\faIcon{star}}%
  \or{\color{white}\faIcon{star}}\hspace{1pt}{\color{white}\faIcon{star}}\hspace{1pt}{\color{starColor}\faIcon{star}}%
  \else #1%
  \fi
}

\tcbset{
  swissenvbase/.style={
    enhanced,
    breakable,
    colback=white,
    colframe=white,
    boxrule=0pt,
    left=0pt,
    right=0pt,
    top=1.5mm,
    bottom=2mm,
    before skip=3.5mm,
    after skip=3.5mm,
    colbacktitle=white,
    titlerule=0pt,
    fonttitle=\normalfont,
    attach boxed title to top left={yshift=0pt, xshift=0pt},
    boxed title style={boxrule=0pt, colback=white, left=0pt, right=0pt, top=0pt, bottom=0pt}
  }
}

% ----------------------------------------------------------------------
% 12. DÉFINITION DES 13 ENVIRONNEMENTS
% ----------------------------------------------------------------------

% 1. Définition
\newtcolorbox[auto counter]{definition}[1][]{
  swissenvbase,
  title={\drawenvbadge{cDef}{\faIcon{book}}{Définition \thetcbcounter}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 2. Théorème
\newtcolorbox[auto counter]{theorem}[1][]{
  swissenvbase,
  title={\drawenvbadge{cThm}{\faIcon{star}}{Théorème \thetcbcounter}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 3. Propriété
\newtcolorbox[auto counter]{property}[1][]{
  swissenvbase,
  title={\drawenvbadge{cProp}{\faIcon{sliders-h}}{Propriété \thetcbcounter}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 4. Conséquence
\newtcolorbox[auto counter]{consequence}[1][]{
  swissenvbase,
  title={\drawenvbadge{cCons}{\faIcon{level-down-alt}}{Conséquence \thetcbcounter}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 5. Corollaire
\newtcolorbox[auto counter]{corollary}[1][]{
  swissenvbase,
  title={\drawenvbadge{cCor}{\faIcon{angle-double-right}}{Corollaire \thetcbcounter}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 6. Application
\newtcolorbox[auto counter]{application}[1][]{
  swissenvbase,
  title={\drawenvbadge{cApp}{\faIcon{rocket}}{Application \thetcbcounter}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 7. Remarque
\newtcolorbox[auto counter]{remark}[1][]{
  swissenvbase,
  title={\drawenvbadge{cRem}{\faIcon{comment-dots}}{Remarque}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 8. Exemple
\newtcolorbox[auto counter]{example}[1][]{
  swissenvbase,
  title={\drawenvbadge{cEx}{\faIcon{lightbulb}}{Exemple \thetcbcounter}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 9. Attention
\newtcolorbox{attention}[1][]{
  swissenvbase,
  title={\drawenvbadge{cAtt}{\faIcon{exclamation-triangle}}{Attention !}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 10. Exercice
% Compteur global (croissant sur tout le document) avec \refstepcounter
% pour rendre \label/\ref opérationnels depuis le corps de l'environnement.
\newcounter{exercisecounter}
\NewDocumentEnvironment{exercise}{O{} O{}}{%
  \refstepcounter{exercisecounter}%
  \begin{tcolorbox}[
    swissenvbase,
    title={\drawenvbadge{cExo}{\faIcon{drafting-compass}}{Exercice~\theexercisecounter}{\ifstrempty{#1}{}{\exercisestars{#1}}}{\ifstrempty{#2}{}{(#2)}}}
  ]
}{%
  \end{tcolorbox}
}

% 11. Correction
\newtcolorbox{correction}[1][]{
  swissenvbase,
  title={\drawenvbadge{cCorr}{\faIcon{check-double}}{Correction}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 12. Méthode
\newtcolorbox[auto counter]{methodbox}[1][]{
  swissenvbase,
  title={\drawenvbadge{cMeth}{\faIcon{magic}}{Méthode}{}{\ifstrempty{#1}{}{(#1)}}}
}

% 13. Environnement personnalisé
\NewDocumentEnvironment{customenv}{m m O{swissdark} O{}}{%
  \begin{tcolorbox}[
    swissenvbase,
    title={\drawenvbadge{#3}{#1}{#2}{}{\ifstrempty{#4}{}{(#4)}}}
  ]
}{%
  \end{tcolorbox}
}

