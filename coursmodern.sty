\newcommand{\MakeSwissCover}{%
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture, overlay]
    \fill[cDef] (current page.north west) rectangle ([yshift=-5pt]current page.north east);
  \end{tikzpicture}
  
  \vspace*{1.5cm}
  
  \noindent
  {\fontsize{10}{12}\selectfont\sffamily\bfseries\color{swissgray}\MakeUppercase{\@CourseSubtitle}}\par
  \vspace{0.4cm}
  
  \ifdefempty{\@ChapterNumber}{}{%
    \noindent
    {\fontsize{44}{48}\selectfont\sffamily\bfseries\color{cDef}\@ChapterNumber}\par
    \vspace{0.1cm}
  }
  
  \noindent
  {\fontsize{28}{34}\selectfont\sffamily\bfseries\color{swissblack}\@CourseTitle}\par
  \vspace{0.6cm}
  \noindent{\color{swissline}\rule{\linewidth}{1.2pt}}\par
  \vspace{0.8cm}
  
  \ifwip
    \noindent\WipBanner\par
    \vspace{1.0cm}
  \fi
  
  \vfill
  
  \noindent
  \begin{minipage}[t]{0.45\linewidth}
    {\fontsize{7.5}{9}\selectfont\sffamily\bfseries\color{swissgray}\MakeUppercase{Auteur}}\par\vspace{2pt}
    {\fontsize{10}{12}\selectfont\sffamily\bfseries\color{swissblack}\@CourseAuthor}\par
    \vspace{0.5cm}
    {\fontsize{7.5}{9}\selectfont\sffamily\bfseries\color{swissgray}\MakeUppercase{Dernière mise à jour}}\par\vspace{2pt}
    {\fontsize{9.5}{12}\selectfont\sffamily\color{swissblack}\@LastUpdate}\par
  \end{minipage}%
  \hfill
  \begin{minipage}[t]{0.5\linewidth}
    {\fontsize{7.5}{9}\selectfont\sffamily\bfseries\color{swissgray}\MakeUppercase{Dépôt principal}}\par\vspace{2pt}
    {\fontsize{8.5}{11}\selectfont\sffamily\href{\@PrimarySiteURL}{\color{cDef}\texttt{\@PrimarySiteText}}}\par
    \vspace{0.5cm}
    {\fontsize{7.5}{9}\selectfont\sffamily\bfseries\color{swissgray}\MakeUppercase{Lien miroir (secours)}}\par\vspace{2pt}
    {\fontsize{8.5}{11}\selectfont\sffamily\href{\@MirrorSiteURL}{\color{swissgray}\texttt{\@MirrorSiteText}}}\par
  \end{minipage}
  
  \vspace*{1.2cm}
  \newpage
  \setcounter{page}{1}
}

