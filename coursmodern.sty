% ----------------------------------------------------------------------
% 6. BANDEAU WORK IN PROGRESS
% ----------------------------------------------------------------------
\newcommand{\WipBanner}{%
  \noindent
  \begin{tikzpicture}
    \clip[rounded corners=3pt] (0,0) rectangle (\linewidth, 1.4);
    \fill[wipBlack] (0,0) rectangle (\linewidth, 1.4);
    \begin{scope}
      \clip (0, 1.15) rectangle (\linewidth, 1.4);
      \fill[wipYellow] (0, 1.15) rectangle (\linewidth, 1.4);
      \foreach \x in {-1, -0.6, ..., 22} {
        \fill[wipBlack] (\x, 1.1) -- (\x + 0.25, 1.1) -- (\x + 0.45, 1.45) -- (\x + 0.2, 1.45) -- cycle;
      }
    \end{scope}
    \node[anchor=west, text=wipYellow, font=\sffamily\bfseries\small] at (0.4, 0.75) {%
      \faIcon{hard-hat} \hspace{2mm}WORK IN PROGRESS%
    };
    \node[anchor=west, text=white!85, font=\sffamily\footnotesize] at (0.4, 0.35) {%
      Ce document est incomplet ou en révision. Certaines sections peuvent faire l'objet de modifications.%
    };
  \end{tikzpicture}\par
}

